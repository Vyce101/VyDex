{
  "name": "vydex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.11.1",
    "npm": "11.6.2"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro dev",
    "typecheck": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro check",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "npm run typecheck && npm test && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build && npm run verify:production-sitemap",
    "build:pages-preview": "npm run build && tsx scripts/deployment/prepare-cloudflare-pages-preview.ts",
    "build:test": "npm run typecheck && npm test && cross-env ASTRO_TELEMETRY_DISABLED=1 astro build --mode test && npm run verify:production-sitemap",
    "preview": "cross-env ASTRO_TELEMETRY_DISABLED=1 astro preview",
    "preview:browser": "wrangler pages dev dist --ip 127.0.0.1 --port 4322 --persist-to runtime/wrangler-state --log-level error --show-interactive-dev-session=false",
    "release:ci": "cross-env ASTRO_TELEMETRY_DISABLED=1 PUBLIC_SITE_ORIGIN=https://vydex.pages.dev tsx scripts/release/release-ci.ts",
    "release:check": "cross-env ASTRO_TELEMETRY_DISABLED=1 PUBLIC_SITE_ORIGIN=https://vydex.pages.dev tsx scripts/release/check-release-selection.ts",
    "release:sync": "cross-env ASTRO_TELEMETRY_DISABLED=1 PUBLIC_SITE_ORIGIN=https://vydex.pages.dev tsx scripts/release/sync-release-selection.ts",
    "release:next": "cross-env ASTRO_TELEMETRY_DISABLED=1 PUBLIC_SITE_ORIGIN=https://vydex.pages.dev tsx scripts/release/next-release.ts",
    "release:stage-1": "npm run release:ci",
    "release:stage-1:ci": "npm run release:ci",
    "release:migrate-stage-1": "cross-env ASTRO_TELEMETRY_DISABLED=1 tsx scripts/release/migrate-stage-one-release.ts",
    "test:browser:install": "playwright install chromium",
    "test:browser": "cross-env PUBLIC_SITE_ORIGIN=https://vydex.example npm run test:browser:configured",
    "test:browser:configured": "npm run build:test && npm run test:browser:run",
    "test:browser:run": "tsx scripts/test/prepare-browser-output.ts && playwright test",
    "test:browser:hosted:run": "playwright test --config playwright.hosted.config.ts",
    "verify:pages-deployment": "tsx scripts/deployment/verify-cloudflare-pages-deployment.ts dist",
    "verify:production-sitemap": "tsx scripts/deployment/verify-production-sitemap.ts dist",
    "verify:hosted-stage-1": "tsx scripts/deployment/verify-hosted-stage-one.ts",
    "deploy:pages-production": "tsx scripts/deployment/deploy-and-verify-cloudflare-pages.ts",
    "rehearse:pages-rollback": "tsx scripts/deployment/rehearse-cloudflare-pages-rollback.ts"
  },
  "dependencies": {
    "@astrojs/sitemap": "3.7.3",
    "@fontsource-variable/source-sans-3": "5.2.9",
    "@fontsource-variable/source-serif-4": "5.2.9",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "astro": "7.1.3",
    "remark-gfm": "4.0.1",
    "remark-mdx": "3.1.1",
    "remark-parse": "11.0.0",
    "unified": "11.0.5",
    "unist-util-visit": "5.1.0",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.9",
    "@axe-core/playwright": "4.12.1",
    "@playwright/test": "1.61.1",
    "@types/node": "24.13.3",
    "cross-env": "10.1.0",
    "parse5": "8.0.1",
    "tsx": "4.23.1",
    "typescript": "6.0.3",
    "uuid": "14.0.1",
    "vitest": "4.1.10",
    "wrangler": "4.114.0"
  },
  "overrides": {
    "fast-uri": "3.1.4"
  }
}
