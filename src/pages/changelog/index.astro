---
// Renders the static Changelog route from the configured application release.
import {
  loadFixedMetadataDevelopmentApplicationRelease,
  loadPersistedProductionApplicationRelease,
} from "../../adapters/application-release";
import { toCanonicalUrl } from "../../domain";
import ChangelogPage from "../../features/changelog-page/ChangelogPage.astro";
import FoundationLayout from "../../layouts/FoundationLayout.astro";

const usesFixedNonProductionMetadata = import.meta.env.DEV || import.meta.env.MODE === "test";
const release = usesFixedNonProductionMetadata
  ? await loadFixedMetadataDevelopmentApplicationRelease({ filesystem_root: process.cwd() })
  : await loadPersistedProductionApplicationRelease({ filesystem_root: process.cwd() });
const canonicalUrl = toCanonicalUrl(release.site_origin, release.routes.changelog);
---

<FoundationLayout title="Changelog — VyDex" canonicalUrl={canonicalUrl}>
  <ChangelogPage events={release.changelog_events} />
</FoundationLayout>
