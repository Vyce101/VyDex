---
// Renders the non-product fixture used to verify Frontier Atlas primitives.
import type {} from "@domain";
import FoundationLayout from "../layouts/FoundationLayout.astro";
---

<FoundationLayout title="Frontier Atlas design-system fixture">
  <main class="atlas-page atlas-stack">
    <header class="atlas-stack atlas-stack--tight">
      <p class="atlas-type-metadata">VYDEX · TECHNICAL FIXTURE</p>
      <h1 class="atlas-type-homepage-title">Frontier Atlas design system</h1>
      <p class="atlas-type-editorial-lead atlas-prose">
        A static verification surface for the typography, evidence states, record structure, and
        interaction primitives used by later VyDex pages.
      </p>
      <span class="atlas-registration-cue" aria-hidden="true"></span>
    </header>

    <div class="atlas-grid" aria-label="Responsive grid columns">
      <span class="atlas-type-metadata">GRID 01</span>
      <span class="atlas-type-metadata">GRID 02</span>
      <span class="atlas-type-metadata">GRID 03</span>
      <span class="atlas-type-metadata">GRID 04</span>
    </div>

    <hr class="atlas-rule atlas-rule--strong" />

    <section class="atlas-sheet atlas-inset atlas-stack" aria-labelledby="record-title">
      <div class="atlas-metadata-band atlas-type-metadata">
        <span>ENTRY FIXTURE</span>
        <time datetime="2026-07-24">Last checked 2026-07-24</time>
        <span class="atlas-status-tab" data-status="supported">Supported</span>
      </div>

      <div class="atlas-rail-layout">
        <div class="atlas-heading-rail atlas-stack atlas-stack--tight">
          <p class="atlas-type-metadata">CLAIM</p>
          <h2 id="record-title" class="atlas-type-entry-title">A representative frontier claim</h2>
        </div>
        <div class="atlas-stack atlas-stack--tight">
          <p class="atlas-type-claim atlas-prose">
            The one-sentence claim uses the approved editorial role without turning evidence into a
            score or reward.
          </p>
          <p class="atlas-type-supporting atlas-prose">
            Supporting interface copy remains visibly secondary while preserving readable contrast.
          </p>
        </div>
      </div>

      <div class="atlas-annotation-layout">
        <div class="atlas-stack atlas-stack--tight">
          <h3 class="atlas-type-major-heading">Evidence interpretation</h3>
          <p class="atlas-type-evidence-body atlas-prose">
            Long-form evidence uses Source Serif 4 and stays near the approved reading measure. The
            record explains what the evidence supports, its scope, and the limits that remain.
          </p>
          <p class="atlas-type-interpretive atlas-prose">
            This interpretive passage is prominent because it changes how the reader should understand
            the evidence, not because it adds a decorative visual accent.
          </p>
          <h4 class="atlas-type-subsection-heading">Record context</h4>
          <p class="atlas-type-interface atlas-prose">
            Interface body text carries the surrounding explanation and includes a
            <a href="#evidence-table">prose link to the evidence table</a>.
          </p>
        </div>
        <aside class="atlas-margin-annotation atlas-type-supporting" aria-label="Repeated record annotation">
          Last checked 2026-07-24. This annotation repeats the date already present in the metadata band.
        </aside>
      </div>
    </section>

    <section class="atlas-stack" aria-labelledby="delta-heading">
      <h2 id="delta-heading" class="atlas-type-major-heading">Frontier Delta</h2>
      <div class="atlas-frontier-delta">
        <article class="atlas-stack atlas-stack--tight">
          <h3 class="atlas-type-subsection-heading">Previous frontier</h3>
          <p class="atlas-type-interface">The earlier reference point.</p>
        </article>
        <article class="atlas-stack atlas-stack--tight">
          <h3 class="atlas-type-subsection-heading">New claim or result</h3>
          <p class="atlas-type-interface">The newly reported evidence.</p>
        </article>
        <article class="atlas-stack atlas-stack--tight">
          <h3 class="atlas-type-subsection-heading">Delta</h3>
          <p class="atlas-type-interface">What materially changed.</p>
        </article>
      </div>
    </section>

    <section id="statuses" class="atlas-sheet atlas-inset atlas-stack atlas-stack--tight" aria-labelledby="status-heading">
      <h2 id="status-heading" class="atlas-type-major-heading">Claim statuses</h2>
      <p class="atlas-type-supporting">
        Every state has a visible text label and border, so color is never the only source of meaning.
      </p>
      <div class="atlas-cluster" aria-label="Representative claim statuses">
        <span class="atlas-status-tab" data-status="supported">Supported</span>
        <span class="atlas-status-tab" data-status="reported_but_unverified">Reported But Unverified</span>
        <span class="atlas-status-tab" data-status="disputed">Disputed</span>
        <span class="atlas-status-tab" data-status="failed_retracted">Failed / Retracted</span>
      </div>
    </section>

    <section class="atlas-stack atlas-stack--tight" aria-labelledby="controls-heading">
      <h2 id="controls-heading" class="atlas-type-major-heading">Controls</h2>
      <div class="atlas-cluster">
        <a class="atlas-button atlas-button--primary" href="#evidence-table">View evidence</a>
        <a class="atlas-button atlas-button--secondary" href="#statuses">Review statuses</a>
      </div>
      <details class="atlas-disclosure">
        <summary>Open fixture disclosure</summary>
        <div class="atlas-disclosure__panel">
          <div class="atlas-disclosure__content">
            <p class="atlas-type-interface">Disclosure content remains available without browser JavaScript.</p>
          </div>
        </div>
      </details>
    </section>

    <section id="evidence-table" class="atlas-stack atlas-stack--tight" aria-labelledby="evidence-heading">
      <h2 id="evidence-heading" class="atlas-type-major-heading">Evidence sources</h2>
      <table class="atlas-table">
        <caption>Representative evidence records</caption>
        <thead>
          <tr>
            <th scope="col">Source</th>
            <th scope="col">Evidence type</th>
            <th scope="col">Used for</th>
          </tr>
        </thead>
        <tbody>
          <tr>
            <td data-label="Source">Technical report</td>
            <td data-label="Evidence type">Developer / Vendor Claim</td>
            <td data-label="Used for">Reported result and stated scope</td>
          </tr>
          <tr>
            <td data-label="Source">Independent evaluation</td>
            <td data-label="Evidence type">Independent Replication</td>
            <td data-label="Used for">External verification and caveats</td>
          </tr>
        </tbody>
      </table>
    </section>

    <section class="atlas-sheet atlas-inset atlas-stack atlas-stack--tight" aria-labelledby="card-heading">
      <p class="atlas-type-metadata">ENTRY CARD</p>
      <h2 id="card-heading" class="atlas-type-entry-card-title">A representative entry-card title</h2>
      <p class="atlas-type-supporting">Compact supporting copy for a later listing interface.</p>
    </section>
  </main>
</FoundationLayout>
