---
// Provides the shared semantic document and site shell for every Stage 1 page.
import "@fontsource-variable/source-sans-3/wght.css";
import "@fontsource-variable/source-serif-4/wght.css";
import SiteFooter from "../components/site-shell/SiteFooter.astro";
import SiteHeader from "../components/site-shell/SiteHeader.astro";
import { getActiveNavigationKey } from "../components/site-shell/navigation";
import "../styles/global.css";

interface Props {
  title: string;
  canonicalUrl?: string;
}

const { title, canonicalUrl } = Astro.props;
const activeNavigationKey = getActiveNavigationKey(Astro.url.pathname);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    {canonicalUrl && <link rel="canonical" href={canonicalUrl} />}
  </head>
  <body>
    <a class="site-skip-link" href="#main-content">Skip to main content</a>
    <SiteHeader activeNavigationKey={activeNavigationKey} />
    <main id="main-content" class="atlas-page" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
