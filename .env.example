# Defines the root-only HTTPS origin used by production releases and the Dataset Schema $id.
PUBLIC_SITE_ORIGIN=https://vydex.example
# Supplies the Cloudflare Pages production deployment boundary.
CLOUDFLARE_ACCOUNT_ID=replace-with-cloudflare-account-id
CLOUDFLARE_API_TOKEN=replace-with-cloudflare-pages-edit-token
CLOUDFLARE_PAGES_PROJECT_NAME=vydex
